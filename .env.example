# =====================================================
# DriveNow Backend — Variables d'environnement
# Copie ce fichier en .env et remplis les valeurs
# =====================================================

PORT=3000

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=car_rental_db

# JWT
JWT_SECRET=change_moi_avec_une_valeur_longue_et_aleatoire
JWT_EXPIRES_IN=7d

# OpenWeather API
OPENWEATHER_API_KEY=ta_cle_openweather_ici

# Frontend URL (pour CORS) — en prod, mets l'URL Vercel
# Plusieurs URLs séparées par des virgules si besoin
FRONTEND_URL=https://ton-app.vercel.app
